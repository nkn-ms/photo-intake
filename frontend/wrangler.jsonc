// Cloudflare Workers の設定（9e。AWS アカウントの確認待ちで CloudFront を作れない間、画面をここで公開する）。
// make deploy-web の wrangler deploy が読む。JSONC は、コメントを書ける JSON。
{
  // Worker の名前。公開の URL は https://photo-intake.<アカウントの workers.dev の名前>.workers.dev になる
  "name": "photo-intake",
  // Workers の動き方をどの日付の版に合わせるか（後から Cloudflare の仕様が変わっても、この日の動きのまま）
  "compatibility_date": "2026-10-13",
  // 処理（main のスクリプト）は書かない。ビルドした画面のファイルを配るだけ（S3 + CloudFront の役目）
  "assets": {
    "directory": "./dist",
    // dist に無いパス（/items/…）には index.html を 200 で返す（CloudFront の custom_error_response と同じ役目）
    "not_found_handling": "single-page-application"
  }
}
